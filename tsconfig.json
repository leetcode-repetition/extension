{
  "compilerOptions": {
    "module": "es2020",
    "moduleResolution": "bundler",
    "target": "es2020",
    "esModuleInterop": true,
    "strict": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "lib": ["ES2020","DOM"],
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types","src/declarations"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules","dist"]
}
